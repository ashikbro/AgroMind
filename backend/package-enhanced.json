{
  "name": "agromind-backend",
  "version": "2.0.0",
  "description": "AgroMind AI Farming Assistant Backend - Enhanced with GraphQL, Redis, and ML",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed": "node scripts/seedDatabase.js",
    "seed:dev": "NODE_ENV=development node scripts/seedDatabase.js",
    "migrate": "node scripts/migrate.js",
    "build": "npm run test && npm run lint",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "docker:build": "docker build -t agromind-backend .",
    "docker:run": "docker run -p 4000:4000 agromind-backend",
    "generate:docs": "apidoc -i routes/ -o docs/",
    "analyze": "npm audit && npm outdated"
  },
  "keywords": ["agriculture", "ai", "farming", "crop-disease", "graphql", "machine-learning", "iot"],
  "author": "AgroMind Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "joi": "^17.9.2",
    "sharp": "^0.32.5",
    "axios": "^1.5.0",
    "uuid": "^9.0.0",
    "nodemailer": "^6.9.4",
    "apollo-server-express": "^3.12.1",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.14.0",
    "redis": "^4.6.8",
    "ioredis": "^5.3.2",
    "bull": "^4.11.3",
    "tensorflow": "^4.10.0",
    "@tensorflow/tfjs-node": "^4.10.0",
    "ml-regression": "^6.0.1",
    "ml-kmeans": "^6.0.0",
    "simple-statistics": "^7.8.3",
    "ws": "^8.14.2",
    "socket.io": "^4.7.2",
    "elasticsearch": "^16.7.3",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "compression": "^1.7.4",
    "express-validator": "^7.0.1",
    "express-slow-down": "^1.6.0",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "csurf": "^1.11.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "node-cron": "^3.0.2",
    "agenda": "^5.0.0",
    "amqplib": "^0.10.3",
    "pg": "^8.11.3",
    "sequelize": "^6.32.1",
    "typeorm": "^0.3.17",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.1.13",
    "inversify": "^6.0.1",
    "dayjs": "^1.11.9",
    "lodash": "^4.17.21",
    "ramda": "^0.29.0",
    "rxjs": "^7.8.1",
    "zod": "^3.22.2",
    "fastify": "^4.21.0",
    "pino": "^8.15.0",
    "openai": "^4.0.0",
    "stripe": "^13.5.0",
    "twilio": "^4.15.0",
    "aws-sdk": "^2.1456.0",
    "cloudinary": "^1.40.0",
    "puppeteer": "^21.1.1",
    "cheerio": "^1.0.0-rc.12",
    "pdf-kit": "^0.13.0",
    "xlsx": "^0.18.5",
    "csv-parser": "^3.0.0",
    "fast-csv": "^4.3.6",
    "mime-types": "^2.1.35",
    "formidable": "^3.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "@types/node": "^20.6.0",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "mongodb-memory-server": "^8.15.1",
    "redis-memory-server": "^0.7.0",
    "apidoc": "^1.2.0",
    "faker": "^5.5.3",
    "@faker-js/faker": "^8.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agromind/backend.git"
  },
  "bugs": {
    "url": "https://github.com/agromind/backend/issues"
  },
  "homepage": "https://agromind.com",
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  }
}
