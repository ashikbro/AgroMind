# ==================================
# AgroMind Backend Configuration
# ==================================

# -----------------------------
# Database Configuration
# -----------------------------
MONGODB_URI=mongodb://localhost:27017/agromind
DB_NAME=agromind

# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agromind?retryWrites=true&w=majority

# -----------------------------
# Server Configuration
# -----------------------------
PORT=5000
NODE_ENV=development

# -----------------------------
# JWT Authentication
# -----------------------------
# IMPORTANT: Change this to a secure random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters
JWT_EXPIRES_IN=7d

# -----------------------------
# CORS Configuration
# -----------------------------
FRONTEND_URL=http://localhost:3000

# For production, set to your frontend domain:
# FRONTEND_URL=https://your-domain.com

# -----------------------------
# Rate Limiting
# -----------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------
# File Upload Configuration
# -----------------------------
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# For AWS S3 storage:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_BUCKET_NAME=agromind-uploads
# AWS_REGION=us-east-1

# -----------------------------
# Weather API Configuration
# -----------------------------
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=demo_key
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# -----------------------------
# Market Data API Configuration
# -----------------------------
# Example: MarketStack API - https://marketstack.com/
COMMODITY_API_KEY=demo_key
COMMODITY_BASE_URL=https://api.marketstack.com/v1

# Alternative Agricultural Data APIs
AGRI_DATA_API_KEY=demo_key

# -----------------------------
# Email Configuration
# -----------------------------
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=AgroMind <noreply@agromind.app>

# For SendGrid:
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# -----------------------------
# AI/ML Service Configuration
# -----------------------------
# OpenAI API for advanced analysis (optional)
OPENAI_API_KEY=your_openai_api_key

# Google Vision API for image analysis (optional)
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Azure Cognitive Services (optional)
AZURE_COMPUTER_VISION_KEY=your_azure_key
AZURE_COMPUTER_VISION_ENDPOINT=your_azure_endpoint

# -----------------------------
# AI Model Configuration
# -----------------------------
AI_MODEL_PATH=../ai-models/crop-disease-model.h5
CONFIDENCE_THRESHOLD=0.75

# -----------------------------
# Redis Configuration (Optional)
# -----------------------------
# For caching and session management
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# For Redis Cloud:
# REDIS_URL=redis://username:password@host:port

# -----------------------------
# Feature Flags
# -----------------------------
ENABLE_VOICE_COMMANDS=true
ENABLE_REAL_TIME_WEATHER=true
ENABLE_MARKET_PRICES=true
ENABLE_EXPERT_CONSULTATION=false
ENABLE_MOBILE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# -----------------------------
# Development Tools
# -----------------------------
DEBUG=agromind:*
ENABLE_SWAGGER_DOCS=true
API_DOCS_PATH=/api-docs

# -----------------------------
# Security Configuration
# -----------------------------
# Enable in production
# HELMET_ENABLED=true
# CORS_WHITELIST=https://your-domain.com,https://www.your-domain.com

# -----------------------------
# Logging Configuration
# -----------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# For production:
# LOG_LEVEL=error
# LOG_FILE=/var/log/agromind/app.log

# -----------------------------
# Performance Configuration
# -----------------------------
# Database connection pool
DB_POOL_SIZE=10

# Request timeout (milliseconds)
REQUEST_TIMEOUT=30000

# -----------------------------
# Third-party Integrations
# -----------------------------
# Twilio for SMS (optional)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Google Maps API (optional)
# GOOGLE_MAPS_API_KEY=your_google_maps_key

# -----------------------------
# Monitoring & Analytics (Optional)
# -----------------------------
# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn

# Google Analytics
# GA_TRACKING_ID=UA-XXXXX-X

# -----------------------------
# Notes
# -----------------------------
# 1. Never commit this file with real credentials to version control
# 2. Copy this file to .env and update with your actual values
# 3. Keep .env in .gitignore
# 4. Use different values for development, staging, and production
# 5. Rotate secrets regularly in production
# 6. Use environment-specific configuration management for production
