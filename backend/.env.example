# AgroMind Environment Variables

# Database
MONGODB_URI=mongodb://localhost:27017/agromind

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# AgroMind Backend Environment Configuration

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agromind
DB_NAME=agromind

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Weather API Configuration
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=demo_key
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Market Data API Configuration
# Example: MarketStack API - https://marketstack.com/
COMMODITY_API_KEY=demo_key
COMMODITY_BASE_URL=https://api.marketstack.com/v1

# Alternative Agricultural Data APIs
AGRI_DATA_API_KEY=demo_key

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=AgroMind <noreply@agromind.app>

# AI/ML Service Configuration
# OpenAI API for advanced disease analysis
OPENAI_API_KEY=your_openai_api_key

# Google Vision API for image analysis
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Azure Cognitive Services
AZURE_COMPUTER_VISION_KEY=your_azure_key
AZURE_COMPUTER_VISION_ENDPOINT=your_azure_endpoint

# Features Toggle
ENABLE_VOICE_COMMANDS=true
ENABLE_REAL_TIME_WEATHER=true
ENABLE_MARKET_PRICES=true
ENABLE_EXPERT_CONSULTATION=false
ENABLE_MOBILE_NOTIFICATIONS=true

# Development Tools
DEBUG=agromind:*
ENABLE_SWAGGER_DOCS=true
API_DOCS_PATH=/api-docs

# AI Model Configuration
AI_MODEL_PATH=../ai-models/crop-disease-model.h5
CONFIDENCE_THRESHOLD=0.75

# External APIs (optional)
WEATHER_API_KEY=your-weather-api-key
MARKET_API_KEY=your-market-api-key

# Redis (for caching - optional)
REDIS_URL=redis://localhost:6379

# File Storage (local/s3)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=agromind-uploads
AWS_REGION=us-east-1
