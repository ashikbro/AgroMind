# Root-level reference environment for AgroMind

# Backend core
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agromind
JWT_SECRET=replace-with-strong-secret
FRONTEND_URL=http://localhost:3000

# AI and integrations (optional)
AI_MODEL_PATH=./ai-models
WEATHER_API_KEY=replace-with-weather-api-key
MARKET_API_KEY=replace-with-market-api-key

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
